{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/HomenSAI/SECURITY-MODULE/spec/schemas/chain-manifest.schema.json",
 "$comment": "HomenS.AI SECURITY-MODULE · © 2026 Serhii Khomenko · https://homensai.com/ · https://github.com/HomenSAI",
 "title": "Подписанный манифест цепочки копий homensai-rent-chain/1 (файл chain/NNNNNN.json)",
 "description": "См. spec/chain.md. Пишет app/archive/chain.py prepare; читает _parse/signature_ok/verify.",
 "type": "object",
 "required": ["manifest", "signature"],
 "additionalProperties": false,
 "properties": {
  "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}==$", "description": "Ed25519, 64 байта, base64url с дополнением"},
  "manifest": {
   "type": "object",
   "required": ["format", "seq", "created_at", "archive", "path", "sha256", "size", "prev", "start", "media", "rent_version", "schema", "encryption", "signer"],
   "additionalProperties": false,
   "properties": {
    "format": {"const": "homensai-rent-chain/1"},
    "seq": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "archive": {"type": "string", "minLength": 1},
    "path": {"type": "string", "minLength": 1},
    "sha256": {"$ref": "#/$defs/hex64"},
    "size": {"type": "integer", "minimum": 0},
    "prev": {"$ref": "#/$defs/hex64"},
    "start": {"type": "boolean"},
    "media": {"type": "array", "items": {"enum": ["internal", "external", "gdrive", "nas", "other", "telegram"]}, "uniqueItems": true},
    "rent_version": {"type": "string"},
    "schema": {"type": "string", "pattern": "^migrations:[0-9]+$"},
    "encryption": {
     "type": "object",
     "required": ["mode", "kid"],
     "additionalProperties": false,
     "properties": {
      "mode": {"enum": ["env", "generated", "custom", "pin", "none"]},
      "kid": {"type": ["string", "null"], "pattern": "^HR1-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}$"}
     }
    },
    "signer": {"type": "string", "pattern": "^HS1-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}$"},
    "integrity": {
     "type": "object",
     "required": ["journal_seq", "journal_hash"],
     "additionalProperties": false,
     "properties": {
      "journal_seq": {"type": "integer", "minimum": 1},
      "journal_hash": {"$ref": "#/$defs/hex64"}
     }
    }
   }
  }
 },
 "$defs": {
  "hex64": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
 }
}
